#!/bin/bash
# Run the site locally:  ./run        (from this project folder in the terminal)
#                        ./run stop   stop the server
#                        ./run log    watch the build log of a running server
#
# Starts the Jekyll dev server DETACHED from the terminal, then opens
# http://127.0.0.1:4000/ and follows the build log. Ctrl+C only stops
# following the log; the server keeps running until `./run stop`.
#
# WHY DETACHED
#
# The server used to run in the foreground of whatever terminal typed ./run,
# which in practice is the VS Code integrated terminal. It then lived and died
# with that terminal: closing the terminal tab, closing or reopening the
# window, "Reload Window", VS Code restarting for an update, or an extension
# reopening the project all took the shell down and Jekyll with it, with
# nothing printed anywhere. Every one of those looked like "the site died".
# Jekyll itself was never the one falling over: stress-tested with bursts of
# saves, broken Liquid mid-edit and requests during rebuilds, it kept serving.
# So now the server is its own process, ignores hangups, and the terminal is
# just a window onto its log.
#
# WHY THE PORT CHECKS AND THE IGNORE FLAG
#
#   1. The file watcher builds its ignore list from `exclude` in _config.yml,
#      not from the leading-underscore rule, so _originals (3.4 GB in iCloud
#      Drive, which touches files on its own) had to be excluded there. The
#      log lives outside the project for the same reason: a log inside the
#      tree is a watcher event on every line, which is a rebuild, which is
#      more log.
#
#   2. --livereload runs on port 35729. If a stale process holds it the
#      reactor thread dies with a long "no acceptor" backtrace that looks like
#      a crash. If the holder is our own server, ./run just reattaches; if it
#      is something else, we serve without live reload rather than die.
#
#   3. Without --incremental Jekyll reports EVERY file as changed on EVERY
#      build, and LiveReload sends one message per file: ~2,000 per save,
#      1,600 of them photographs, which the browser answered with a reload
#      each and went down. --livereload-ignore keeps static assets out of the
#      message. Nothing is lost: every page carries ?v=<mtime> for its CSS and
#      JS (see _includes/v.html), so a changed stylesheet changes every page.

cd "$(dirname "$0")" || exit 1

# The cache-busting hashes (_data/versions.yml for CSS/JS, photo_versions.yml
# for the photographs; see tools/stamp.py) are refreshed here and by the
# pre-commit hook in tools/hooks, which this wires up once. The hook only
# touches those two generated files.
python3 tools/stamp.py --quiet 2>/dev/null
[ "$(git config core.hooksPath 2>/dev/null)" = "tools/hooks" ] || git config core.hooksPath tools/hooks 2>/dev/null

# Use the Homebrew Ruby (falls back to whatever's on PATH if not present)
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
fi

LOG="$HOME/Library/Logs/abubakr-site.log"
LIVERELOAD_PORT=35729

holder()  { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1; }
is_ours() { ps -o command= -p "$1" 2>/dev/null | grep -q "jekyll serve"; }

# `./run --port 4001` has to actually work, so honour a --port in the arguments
PORT=4000
for i in "$@"; do
  if [ "$prev" = "--port" ]; then PORT="$i"; fi
  if [ "$prev" = "--livereload-port" ]; then LIVERELOAD_PORT="$i"; fi
  prev="$i"
done
case " $* " in *" --port "*) OWN_PORT="" ;; *) OWN_PORT="--port $PORT" ;; esac

case "$1" in
  stop)
    pid=$(holder "$PORT")
    if [ -z "$pid" ]; then echo "Nothing is serving on port $PORT."; exit 0; fi
    if ! is_ours "$pid"; then
      echo "Port $PORT is held by PID $pid, which is not our Jekyll server:"
      echo "    $(ps -o command= -p "$pid" | cut -c1-100)"
      exit 1
    fi
    kill "$pid" && echo "Stopped the site server (PID $pid)."
    exit 0 ;;
  log)
    [ -f "$LOG" ] || { echo "No log yet at $LOG. Run ./run first."; exit 1; }
    exec tail -n 40 -f "$LOG" ;;
esac

# ── already running? then this is just "open it again" ──
pid=$(holder "$PORT")
if [ -n "$pid" ]; then
  if is_ours "$pid"; then
    echo "The site is already being served on http://127.0.0.1:$PORT/ (PID $pid)."
    echo "Following its log; Ctrl+C stops following, ./run stop stops the server."
    echo
    open "http://127.0.0.1:$PORT/"
    exec tail -n 20 -f "$LOG"
  fi
  echo "Port $PORT is already taken by PID $pid:"
  echo "    $(ps -o command= -p "$pid" 2>/dev/null | cut -c1-100)"
  echo
  echo "Either:  kill $pid          # then run ./run again"
  echo "    or:  ./run --port 4001  # use another port"
  exit 1
fi

# ── the live-reload port: recoverable, so recover ──
LIVERELOAD=(--livereload --livereload-ignore '/assets/*')
pid=$(holder "$LIVERELOAD_PORT")
if [ -n "$pid" ]; then
  echo "Live reload port $LIVERELOAD_PORT is held by PID $pid, so starting without it."
  echo "The site will still serve and rebuild; the browser just will not refresh itself."
  echo "To get it back:  kill $pid"
  echo
  LIVERELOAD=()
fi

# ── start detached: survives the terminal, the window, and VS Code itself ──
mkdir -p "$(dirname "$LOG")"
: > "$LOG"
nohup bundle exec jekyll serve --host 127.0.0.1 $OWN_PORT "${LIVERELOAD[@]}" "$@" >> "$LOG" 2>&1 < /dev/null &
disown

# Wait for it to come up (a full build is ~5 s) before opening the browser
for i in $(seq 1 60); do
  [ -n "$(holder "$PORT")" ] && break
  if ! kill -0 $! 2>/dev/null; then
    echo "The server exited during startup. Its output:"; echo; cat "$LOG"; exit 1
  fi
  sleep 0.5
done
if [ -z "$(holder "$PORT")" ]; then
  echo "The server has not come up after 30 s. Its log so far:"; echo; cat "$LOG"
  echo; echo "It may still be building; ./run log to keep watching."; exit 1
fi

echo "Local site running at http://127.0.0.1:$PORT/"
echo "It runs on its own now: closing this terminal or VS Code does not stop it."
echo "Ctrl+C stops following the log; ./run stop stops the server."
echo
open "http://127.0.0.1:$PORT/"
exec tail -n +1 -f "$LOG"
