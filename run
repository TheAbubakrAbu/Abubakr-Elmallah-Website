#!/bin/bash
# Run the site locally:  ./run        (from this project folder in the terminal)
#                        ./run stop   stop every copy of the server
#                        ./run log    watch the build log of a running server
#
# And for anything else running on this Mac (not just the site):
#                        ./run ports              list every program serving a port
#                        ./run kill               stop every website of yours
#                        ./run kill <PID>         stop one program by its PID
#                        ./run kill -9 <PID>      force it, if it will not stop
#                        ./run killall <name>     stop every program of yours matching <name>
#
# Every ./run first stops ALL running copies of the Jekyll server (any port,
# any terminal, any leftover from a closed window) and the terminals still
# following their log, then starts one fresh server DETACHED from the
# terminal, opens http://127.0.0.1:4000/ and follows the build log. Ctrl+C
# only stops following the log; the server keeps running until `./run stop`.
#
# WHY DETACHED
#
# The server used to run in the foreground of whatever terminal typed ./run,
# which in practice is the VS Code integrated terminal. It then lived and died
# with that terminal: closing the terminal tab, closing or reopening the
# window, "Reload Window", VS Code restarting for an update, or an extension
# reopening the project all took the shell down and Jekyll with it, with
# nothing printed anywhere. Every one of those looked like "the site died".
# Jekyll itself was never the one falling over: stress-tested with bursts of
# saves, broken Liquid mid-edit and requests during rebuilds, it kept serving.
# So now the server is its own process, ignores hangups, and the terminal is
# just a window onto its log.
#
# WHY THE PORT CHECKS AND THE IGNORE FLAG
#
#   1. The file watcher builds its ignore list from `exclude` in _config.yml,
#      not from the leading-underscore rule, so _originals (3.4 GB in iCloud
#      Drive, which touches files on its own) had to be excluded there. The
#      log lives outside the project for the same reason: a log inside the
#      tree is a watcher event on every line, which is a rebuild, which is
#      more log.
#
#   2. --livereload runs on port 35729. If a stale process holds it the
#      reactor thread dies with a long "no acceptor" backtrace that looks like
#      a crash. If the holder is our own server, ./run just reattaches; if it
#      is something else, we serve without live reload rather than die.
#
#   3. Without --incremental Jekyll reports EVERY file as changed on EVERY
#      build, and LiveReload sends one message per file: ~2,000 per save,
#      1,600 of them photographs, which the browser answered with a reload
#      each and went down. --livereload-ignore keeps static assets out of the
#      message. Nothing is lost: every page carries ?v=<mtime> for its CSS and
#      JS (see _includes/v.html), so a changed stylesheet changes every page.

cd "$(dirname "$0")" || exit 1

# The cache-busting hashes (_data/versions.yml for CSS/JS, photo_versions.yml
# for the photographs; see tools/stamp.py) are refreshed here and by the
# pre-commit hook in tools/hooks, which this wires up once. The hook only
# touches those two generated files.
python3 tools/stamp.py --quiet 2>/dev/null
[ "$(git config core.hooksPath 2>/dev/null)" = "tools/hooks" ] || git config core.hooksPath tools/hooks 2>/dev/null

# Use the Homebrew Ruby (falls back to whatever's on PATH if not present)
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
fi

LOG="$HOME/Library/Logs/abubakr-site.log"
LIVERELOAD_PORT=35729

holder()  { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1; }

# `./run --port 4001` has to actually work, so honour a --port in the arguments
PORT=4000
for i in "$@"; do
  if [ "$prev" = "--port" ]; then PORT="$i"; fi
  if [ "$prev" = "--livereload-port" ]; then LIVERELOAD_PORT="$i"; fi
  prev="$i"
done
case " $* " in *" --port "*) OWN_PORT="" ;; *) OWN_PORT="--port $PORT" ;; esac

# Stops every `jekyll serve` this user is running, whatever port or terminal
# started it, plus any `tail` still following the old log. Politely first,
# then forcefully for anything that has not let go after 5 s.
stop_all() {
  local pids tails
  pids=$(pgrep -u "$(id -u)" -f "bin/jekyll serve")
  tails=$(pgrep -u "$(id -u)" -f "tail .*$(basename "$LOG")")
  [ -n "$tails" ] && kill $tails 2>/dev/null
  if [ -z "$pids" ]; then return 1; fi
  kill $pids 2>/dev/null
  for i in $(seq 1 20); do
    pgrep -u "$(id -u)" -f "bin/jekyll serve" >/dev/null || break
    sleep 0.25
  done
  pids=$(pgrep -u "$(id -u)" -f "bin/jekyll serve")
  [ -n "$pids" ] && kill -9 $pids 2>/dev/null
  return 0
}

case "$1" in
  stop)
    before=$(pgrep -u "$(id -u)" -f "bin/jekyll serve" | xargs)
    if stop_all; then echo "Stopped every site server (PID $before)."
    else echo "No site server was running."; fi
    exit 0 ;;
  log)
    [ -f "$LOG" ] || { echo "No log yet at $LOG. Run ./run first."; exit 1; }
    exec tail -n 40 -f "$LOG" ;;
  ports)
    # One line per program and port (lsof lists IPv4 and IPv6 separately)
    printf "%-7s  %-22s  %s\n" PID PROGRAM ADDRESS
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR>1 { print $2, $9 }' | sort -u -k1,1n -k2 |
      while read -r pid addr; do
        name=$(basename "$(ps -o comm= -p "$pid" 2>/dev/null)")
        printf "%-7s  %-22s  %s\n" "$pid" "${name:0:22}" "$addr"
      done
    echo
    echo "Stop one with:  ./run kill <PID>"
    exit 0 ;;
  kill)
    sig=""; [ "$2" = "-9" ] && { sig="-9"; shift; }
    pid="$2"
    # ── ./run kill  with no PID: stop every website of yours ──
    # "kill" on its own used to be a usage error, which is useless when the
    # real question is "something is still serving a site and I do not care
    # what". This stops every DEV WEB SERVER this user owns: the Jekyll site
    # on any port or terminal, a stray `python3 -m http.server`, a node/vite/
    # next/webpack dev server, `php -S`, `ruby -run -e httpd`, http-server,
    # live-server, serve.
    #
    # WHY IT IS A LIST AND NOT "EVERYTHING LISTENING". Plenty of things of
    # yours hold a TCP port that you would be furious to lose: VS Code's
    # helpers, Control Centre on 5000/7000, rapportd, a database. Killing by
    # "it listens on a port" takes those with it. So this matches on what the
    # process actually IS, and anything not on the list is left alone.
    if [ -z "$pid" ]; then
      stop_all >/dev/null   # the site server and its log tails, politely first
      pat='bin/jekyll serve|http\.server|http-server|live-server|SimpleHTTPServer|vite|webpack-dev-server|next dev|nuxt dev|ng serve|php -S|ruby -run|node .*\bserve\b'
      mine=$(pgrep -u "$(id -u)" -f "$pat" | grep -v -e "^$$\$" -e "^$PPID\$" | sort -un)
      if [ -z "$mine" ]; then echo "No website of yours is running."; exit 0; fi
      echo "Stopping:"
      for p in $mine; do
        printf '    %-7s %s\n' "$p" "$(ps -o command= -p "$p" 2>/dev/null | cut -c1-88)"
      done
      kill $mine 2>/dev/null
      still=""
      for i in $(seq 1 20); do
        still=$(pgrep -u "$(id -u)" -f "$pat" | grep -v -e "^$$\$" -e "^$PPID\$")
        [ -z "$still" ] && break
        sleep 0.25
      done
      [ -n "$still" ] && kill -9 $still 2>/dev/null
      echo "Done. (./run ports lists anything still holding a port.)"
      exit 0
    fi
    case "$pid" in *[!0-9]*) echo "Usage: ./run kill             stop every web server of yours"; echo "       ./run kill [-9] <PID>  stop one   (./run ports lists them)"; exit 1 ;; esac
    what=$(ps -o command= -p "$pid" 2>/dev/null | cut -c1-100)
    [ -n "$what" ] || { echo "No process with PID $pid."; exit 1; }
    kill $sig "$pid" && echo "Stopped PID $pid:  $what"
    exit $? ;;
  killall)
    name="$2"
    [ -n "$name" ] || { echo "Usage: ./run killall <name>   e.g. ./run killall node"; exit 1; }
    found=$(pgrep -u "$(id -u)" -fl "$name" | grep -v -e "^$$ " -e "^$PPID ")
    [ -n "$found" ] || { echo "Nothing of yours is running that matches \"$name\"."; exit 0; }
    echo "Stopping:"; echo "$found" | cut -c1-100 | sed 's/^/    /'
    kill $(echo "$found" | awk '{ print $1 }') 2>/dev/null
    exit 0 ;;
esac

# ── erase any old copies, so this is always one fresh server ──
before=$(pgrep -u "$(id -u)" -f "bin/jekyll serve" | xargs)
if stop_all >/dev/null; then echo "Stopped the old site server (PID $before)."; echo; fi

# ── anything else still on the port is not ours: say so rather than kill it ──
pid=$(holder "$PORT")
if [ -n "$pid" ]; then
  echo "Port $PORT is already taken by PID $pid:"
  echo "    $(ps -o command= -p "$pid" 2>/dev/null | cut -c1-100)"
  echo
  echo "Either:  kill $pid          # then run ./run again"
  echo "    or:  ./run --port 4001  # use another port"
  exit 1
fi

# ── the live-reload port: recoverable, so recover ──
LIVERELOAD=(--livereload --livereload-ignore '/assets/*')
pid=$(holder "$LIVERELOAD_PORT")
if [ -n "$pid" ]; then
  echo "Live reload port $LIVERELOAD_PORT is held by PID $pid, so starting without it."
  echo "The site will still serve and rebuild; the browser just will not refresh itself."
  echo "To get it back:  kill $pid"
  echo
  LIVERELOAD=()
fi

# ── start detached: survives the terminal, the window, and VS Code itself ──
mkdir -p "$(dirname "$LOG")"
: > "$LOG"
nohup bundle exec jekyll serve --host 127.0.0.1 $OWN_PORT "${LIVERELOAD[@]}" "$@" >> "$LOG" 2>&1 < /dev/null &
disown

# Wait for it to come up (a full build is ~5 s) before opening the browser
for i in $(seq 1 60); do
  [ -n "$(holder "$PORT")" ] && break
  if ! kill -0 $! 2>/dev/null; then
    echo "The server exited during startup. Its output:"; echo; cat "$LOG"; exit 1
  fi
  sleep 0.5
done
if [ -z "$(holder "$PORT")" ]; then
  echo "The server has not come up after 30 s. Its log so far:"; echo; cat "$LOG"
  echo; echo "It may still be building; ./run log to keep watching."; exit 1
fi

echo "Local site running at http://127.0.0.1:$PORT/"
echo "It runs on its own now: closing this terminal or VS Code does not stop it."
echo "Ctrl+C stops following the log; ./run stop stops the server."
echo
open "http://127.0.0.1:$PORT/"
exec tail -n +1 -f "$LOG"
