#!/bin/sh
# Keeps _data/versions.yml (the CSS/JS cache-busting hashes) and
# _data/photo_versions.yml (the same for the gallery photographs, read by
# sw.js) in step with the files being committed. Installed by ./run via
# `git config core.hooksPath`.
cd "$(git rev-parse --show-toplevel)" || exit 0
python3 tools/stamp.py --quiet
git add _data/versions.yml _data/photo_versions.yml 2>/dev/null
exit 0
